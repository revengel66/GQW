@startuml
title Диаграмма компонентов Analytics Module

left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2F3A4A
  FontColor #111827
}
skinparam package {
  BackgroundColor #F4F6F8
  BorderColor #B8C2CC
  FontColor #111827
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #2F3A4A
}

actor "Покупатель" as Buyer
actor "Администратор" as Admin

node "Spring Boot приложение интернет-магазина" as App {
  package "Shop Application" as ShopApplication {
    component "Frontend Shop" as FrontendShop
    component "Admin Panel" as AdminPanel
    component "Backend Shop" as BackendShop
  }

  package "gqw-analytics-module" as AnalyticsModule {
    component "AOP Instrumentation" as AopInstrumentation
    component "Event Capture Layer" as EventCapture
    component "Snapshot / Async Pipeline" as SnapshotPipeline
    component "Analytics Admin API" as AdminApi
    component "Analytics Admin UI" as AdminUi
    component "Dictionary & Strict Model" as DictionaryStrict
    component "Aggregation & Rollup" as AggregationRollup
    component "Trace Log Index" as TraceLogIndex
    component "Diagnostics & Runtime Settings" as RuntimeSettings
  }
}

package "Infrastructure" as Infrastructure {
  database "PostgreSQL gqw" as PgShop
  database "PostgreSQL gqw_analytics" as PgAnalytics
  component "Log Files" as LogFiles
}

package "External Dependencies" as Dependencies {
  component "Spring Web" as SpringWeb
  component "Spring Data JPA" as SpringDataJpa
  component "Spring Security" as SpringSecurity
  component "Thymeleaf" as Thymeleaf
}

Buyer --> FrontendShop
Admin --> AdminPanel
Admin --> AdminUi

FrontendShop --> BackendShop
AdminPanel --> BackendShop
BackendShop --> AopInstrumentation

AopInstrumentation --> EventCapture
EventCapture --> SnapshotPipeline
SnapshotPipeline --> PgAnalytics

AdminUi --> AdminApi
AdminApi --> PgAnalytics
AdminApi --> AggregationRollup
AdminApi --> DictionaryStrict
AdminApi --> TraceLogIndex

DictionaryStrict --> PgAnalytics
AggregationRollup --> PgAnalytics
TraceLogIndex --> LogFiles
TraceLogIndex --> PgAnalytics
RuntimeSettings --> PgAnalytics

BackendShop --> PgShop

FrontendShop ..> SpringWeb
BackendShop ..> SpringWeb
BackendShop ..> SpringDataJpa
AdminApi ..> SpringWeb
AdminApi ..> SpringSecurity
AdminUi ..> Thymeleaf
SnapshotPipeline ..> SpringDataJpa
AggregationRollup ..> SpringDataJpa
DictionaryStrict ..> SpringDataJpa
TraceLogIndex ..> SpringDataJpa

@enduml
