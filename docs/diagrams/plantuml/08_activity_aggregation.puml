@startuml
title Диаграмма деятельности «Агрегация данных»

skinparam shadowing false

start
partition "Планировщик" {
  :AggregationScheduler запускает job;
}
partition "Analytics Module" {
  :Проверяется AnalyticsScheduledJobsPolicy;
  if (Фоновые задания включены?) then (да)
    :Выбирается окно пересчёта;
  else (нет)
    stop
  endif
}
partition "БД gqw_analytics" {
  :Читаются analytics.event,\nanalytics.stage,\nanalytics.stage_metric;
}
partition "Analytics Module" {
  :Рассчитываются count, avg,\np95, p99, error rate;
  :Формируются buckets\n1 минута, 5 минут, 1 час, 1 день;
}
partition "БД gqw_analytics" {
  :Обновляются event_rollup_bucket,\nstage_rollup_bucket,\nstage_metric_rollup_bucket;
  :Записывается aggregation_run;
  :Обновляется time_rollup_watermark;
  :Очищаются устаревшие агрегаты\nпо retention;
}
partition "Analytics Module" {
  if (Ошибка?) then (да)
    :Фиксируется статус ошибки\nи служебная диагностика;
  else (нет)
    :Фиксируется успешное выполнение;
  endif
}
stop
@enduml
