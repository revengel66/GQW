@startuml
title Диаграмма деятельности «Загрузка аналитических данных в интерфейсе администратора»

skinparam shadowing false

start
partition "Администратор" {
  :Открывает раздел Analytics Admin;
  :Выбирает вкладку или меняет фильтры;
}
partition "UI" {
  :Определяется активная вкладка;
  :Данные активной вкладки\nзагружаются первыми;
  :Второстепенные данные\nдозагружаются позже;
  if (Есть предыдущий запрос?) then (да)
    :Старый запрос отменяется\nили результат игнорируется;
  endif
}
partition "Analytics Module" {
  :Для журналов используется\nпостраничная загрузка;
  :Для фильтров вызывается\nfilter-options;
  if (Период длинный?) then (да)
    :Используются fast filters;
  endif
  :Для графиков используются\nrollup-агрегаты;
}
partition "БД gqw_analytics" {
  :Возвращает данные активного запроса;
}
partition "UI" {
  if (Загрузка успешна?) then (да)
    :Показываются графики,\nтаблицы и уведомление;
  else (нет)
    :Показывается понятное\nсообщение об ошибке;
  endif
}
stop
@enduml
