@startuml
title Диаграмма классов «Слой записи аналитических событий»

left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0

package "com.example.gqw.analytics.service" {
  class AnalyticsTrackerFacade {
    -eventService : AnalyticsEventService
    -stageService : AnalyticsStageService
    -metricService : AnalyticsStageMetricService
    -attributeService : AnalyticsEventAttributeService
    -snapshotBuffer : AnalyticsEventSnapshotBuffer
    -asyncWriteBuffer : AnalyticsAsyncWriteBuffer
    +isSnapshotEnabled() : boolean
    +startEvent(...) : UUID
    +addAttribute(...) : void
    +startStage(...) : Long
    +recordMetricNum(...) : void
    +finishEventSuccess(...) : void
    +finishEventError(...) : void
  }

  class AnalyticsEventService {
    -eventRepository : AnalyticsEventRepository
    -eventTypeRepository : EventTypeRepository
    -moduleTypeRepository : ModuleTypeRepository
    +createEvent(...) : AnalyticsEvent
    +findByEventUid(eventUid) : AnalyticsEvent
    +setStartedAtIfEarlier(...) : void
    +extendEventDurationIfLater(...) : void
    +finishEventSuccess(...) : void
    +finishEventError(...) : void
  }

  class AnalyticsStageService {
    -stageRepository : AnalyticsStageRepository
    -stageTypeRepository : StageTypeRepository
    +createStage(event, stageTypeCode, stageOrder) : AnalyticsStage
    +finishStageSuccess(stageId) : void
    +finishStageError(stageId, errorMessage) : void
    +markStageLogWindow(...) : void
  }

  class AnalyticsStageMetricService {
    -metricRepository : AnalyticsStageMetricRepository
    -metricTypeRepository : StageMetricTypeRepository
    +recordMetricNum(...) : void
    +recordMetricText(...) : void
  }

  class AnalyticsEventAttributeService {
    -attributeRepository : AnalyticsEventAttributeRepository
    -attributeTypeRepository : EventAttributeTypeRepository
    +addTextAttribute(...) : void
    +addJsonAttribute(...) : void
  }

  class AnalyticsEventSnapshot {
    -eventUid : UUID
    -eventTypeCode : String
    -moduleCode : String
    -traceId : String
    -attributes : List<AttributeSnapshot>
    -stages : Map<Long, StageSnapshot>
    +eventUid() : UUID
    +traceId() : String
    +addAttribute(...) : void
    +addStage(...) : void
    +finishStageSuccess(...) : void
    +finishSuccess(...) : void
  }

  class AnalyticsEventSnapshotBuffer {
    -queue : BlockingQueue<AnalyticsEventSnapshot>
    -currentSnapshots : ConcurrentMap<UUID, AnalyticsEventSnapshot>
    -persistenceService : AnalyticsEventSnapshotPersistenceService
    +start() : void
    +stop() : void
    +isEnabled() : boolean
    +pendingSnapshots() : int
    +startEvent(...) : UUID
    +finishEventSuccess(...) : void
    +finishEventError(...) : void
  }

  class AnalyticsEventSnapshotPersistenceService {
    -eventRepository : AnalyticsEventRepository
    -stageRepository : AnalyticsStageRepository
    -metricRepository : AnalyticsStageMetricRepository
    -attributeRepository : AnalyticsEventAttributeRepository
    +persist(snapshot) : void
  }

  class AnalyticsAsyncWriteBuffer {
    -queue : BlockingQueue<AnalyticsWriteOperation>
    -droppedOperations : AtomicLong
    -eventService : AnalyticsEventService
    +start() : void
    +stop() : void
    +isEnabled() : boolean
    +pendingOperations() : int
    +startEvent(...) : UUID
    +recordMetricNum(...) : void
    +finishEventError(...) : void
  }

  interface AnalyticsCurrentUserProvider {
    +currentUserId() : Optional<String>
    +currentUsername() : Optional<String>
    +currentUserRole() : Optional<String>
  }

  class NoopAnalyticsCurrentUserProvider {
    +currentUserId() : Optional<String>
    +currentUsername() : Optional<String>
    +currentUserRole() : Optional<String>
  }

  class AnalyticsInstrumentationPolicy {
    -enabled : boolean
    +isEnabled() : boolean
  }
}

package "com.example.gqw.analytics.entity" {
  class AnalyticsEvent
  class AnalyticsStage
  class AnalyticsStageMetric
  class AnalyticsEventAttribute
}

AnalyticsTrackerFacade --> AnalyticsEventSnapshotBuffer : snapshot mode
AnalyticsTrackerFacade --> AnalyticsAsyncWriteBuffer : async mode
AnalyticsTrackerFacade --> AnalyticsEventService : direct mode
AnalyticsEventSnapshotBuffer --> AnalyticsEventSnapshot : хранит
AnalyticsEventSnapshotBuffer --> AnalyticsEventSnapshotPersistenceService : flush
AnalyticsAsyncWriteBuffer --> AnalyticsEventService
AnalyticsAsyncWriteBuffer --> AnalyticsStageService
AnalyticsAsyncWriteBuffer --> AnalyticsStageMetricService
AnalyticsAsyncWriteBuffer --> AnalyticsEventAttributeService
AnalyticsEventSnapshotPersistenceService --> AnalyticsEvent : save
AnalyticsEventSnapshotPersistenceService --> AnalyticsStage : save
AnalyticsEventSnapshotPersistenceService --> AnalyticsStageMetric : save
AnalyticsEventSnapshotPersistenceService --> AnalyticsEventAttribute : save
AnalyticsEventService --> AnalyticsEvent : creates
AnalyticsStageService --> AnalyticsStage : creates
AnalyticsStageMetricService --> AnalyticsStageMetric : creates
AnalyticsEventAttributeService --> AnalyticsEventAttribute : creates
NoopAnalyticsCurrentUserProvider ..|> AnalyticsCurrentUserProvider
AnalyticsTrackerFacade --> AnalyticsInstrumentationPolicy
@enduml
