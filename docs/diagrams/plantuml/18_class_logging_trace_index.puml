@startuml
title Диаграмма классов «Логирование и индекс трассировок»

left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0

package "com.example.gqw.analytics.logging" {
  class AnalyticsMethodLoggingAspect {
    +logMethod(...)
  }
  class AppModuleMdcFilter
  interface AnalyticsOperationDescriptionResolver
  class DefaultAnalyticsOperationDescriptionResolver
}

package "com.example.gqw.analytics.support" {
  class AnalyticsTraceContext {
    +TRACE_ID_MDC_KEY
    +EVENT_UID_MDC_KEY
    +APP_MODULE_MDC_KEY
  }
}

package "com.example.gqw.analytics.service" {
  class AnalyticsLogArchiveIndexService {
    +indexAvailableFilesNow()
  }
  class AnalyticsLogViewService {
    +loadTraceLogs(...)
  }
  class AnalyticsTraceLogLookupService {
    +loadTraceLogsSafely(...)
  }
  class AnalyticsLoggingPolicy
  class AnalyticsRuntimeSettingsService
}

database "analytics.log_file_index" as file_index
database "analytics.log_trace_index" as trace_index
database "analytics.log_problem_excerpt" as excerpt
folder ".log / .log.gz" as files

DefaultAnalyticsOperationDescriptionResolver ..|> AnalyticsOperationDescriptionResolver
AnalyticsMethodLoggingAspect --> AnalyticsOperationDescriptionResolver
AnalyticsMethodLoggingAspect --> AnalyticsTraceContext : MDC keys
AppModuleMdcFilter --> AnalyticsTraceContext : module MDC
AnalyticsMethodLoggingAspect --> AnalyticsLoggingPolicy : built-in logs
AnalyticsLogArchiveIndexService --> AnalyticsRuntimeSettingsService : log settings
AnalyticsLogArchiveIndexService --> files : reads
AnalyticsLogArchiveIndexService --> file_index : writes
AnalyticsLogArchiveIndexService --> trace_index : writes
AnalyticsLogArchiveIndexService --> excerpt : writes
AnalyticsLogViewService --> files : reads full lines
AnalyticsLogViewService --> trace_index : reads summary
AnalyticsLogViewService --> excerpt : reads excerpts
AnalyticsTraceLogLookupService --> AnalyticsLogViewService : isolated lookup
@enduml
