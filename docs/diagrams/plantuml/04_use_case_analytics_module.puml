@startuml
title Диаграмма вариантов использования модуля объединённой аналитики пользовательских событий

left to right direction
skinparam shadowing false

actor "Приложение-носитель" as host
actor "Разработчик" as dev
actor "Администратор / аналитик" as admin
actor "Планировщик\nфоновых задач" as scheduler

rectangle "gqw-analytics-module" {
  usecase "Фиксировать\nпользовательское событие" as uc_event
  usecase "Фиксировать\nатрибут события" as uc_attr
  usecase "Фиксировать\nэтап выполнения" as uc_stage
  usecase "Фиксировать\nметрику этапа" as uc_metric
  usecase "Передавать traceId/eventUid\nв контекст запроса" as uc_trace

  usecase "Подключить модуль\nкак зависимость" as uc_dep
  usecase "Расставить аннотации\nинструментирования" as uc_ann
  usecase "Настроить datasource\nаналитики" as uc_ds
  usecase "Настроить справочники\nи strict-модель" as uc_dict

  usecase "Просматривать дашборд" as uc_dash
  usecase "Просматривать\nжурнал событий" as uc_journal
  usecase "Открывать\nдетали события" as uc_details
  usecase "Просматривать\nлоги трассировки" as uc_logs
  usecase "Сравнивать периоды" as uc_compare
  usecase "Настраивать\nпараметры модуля" as uc_settings
  usecase "Управлять\nсправочниками" as uc_admin_dict

  usecase "Агрегировать данные" as uc_agg
  usecase "Обновлять\nrollup-бакеты" as uc_rollup
  usecase "Обновлять\nбыстрые фильтры" as uc_fast
  usecase "Индексировать логи" as uc_index
  usecase "Очищать\nустаревшие данные" as uc_lifecycle
}

host --> uc_event
host --> uc_stage
host --> uc_metric
host --> uc_attr
host --> uc_trace
dev --> uc_dep
dev --> uc_ann
dev --> uc_ds
dev --> uc_dict
admin --> uc_dash
admin --> uc_journal
admin --> uc_details
admin --> uc_compare
admin --> uc_settings
admin --> uc_admin_dict
scheduler --> uc_agg
scheduler --> uc_fast
scheduler --> uc_index
scheduler --> uc_lifecycle

uc_event .> uc_attr : <<include>>
uc_event .> uc_stage : <<include>>
uc_stage .> uc_metric : <<include>>
uc_details <. uc_logs : <<extend>>
uc_agg .> uc_rollup : <<include>>
@enduml
