    join analytics.event e on e.id = s.event_id
    where sm.recorded_at >= ?
      and sm.recorded_at < ?
      and e.event_type_code is not null
      and s.stage_type_code is not null
      and sm.metric_type_code is not null
    group by 1, 3, 4, 5, 6
    on conflict (
