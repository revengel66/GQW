        numeric_count,
        numeric_sum,
        p95_value,
        min_value,
        max_value
    )
    select
        date_bin(
            (? || ' minutes')::interval,
            sm.recorded_at,
            ?
        ) as bucket_start,
        ? as granularity_minutes,
        coalesce(e.module_code, ?) as module_code,
        e.event_type_code,
        s.stage_type_code,
