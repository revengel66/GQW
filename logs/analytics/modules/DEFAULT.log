        granularity_minutes,
        module_code,
        event_type_code,
        stage_type_code,
        metric_type_code
    )
    do update set
        unit = excluded.unit,
        sample_count = excluded.sample_count,
        numeric_count = excluded.numeric_count,
        numeric_sum = excluded.numeric_sum,
