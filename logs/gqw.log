        p95_ms,
        p99_ms,
        max_ms
    )
    select
        date_bin(
            (? || ' minutes')::interval,
            e.started_at,
            ?
        ) as bucket_start,
        ? as granularity_minutes,
        coalesce(e.module_code, ?) as module_code,
