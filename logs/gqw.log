        day_start,
        module_code,
        event_type_code,
        attribute_type_code,
        attribute_value,
        sample_count
    )
    select
        (e.started_at at time zone 'UTC')::date as day_start,
        e.module_code,
        e.event_type_code,
        a.attribute_type_code,
        left(trim(coalesce(nullif(a.attr_value, ''), nullif(a.attr_value_json, ''))), 255) as attribute_value,
        count(*) as sample_count
