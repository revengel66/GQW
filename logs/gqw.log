        numeric_sum,
        p95_value,
        min_value,
        max_value
    )
    select
        date_bin(
            (? || ' minutes')::interval,
            sm.recorded_at,
            ?
        ) as bucket_start,
        ? as granularity_minutes,
        coalesce(e.module_code, ?) as module_code,
        e.event_type_code,
        s.stage_type_code,
        sm.metric_type_code,
        min(nullif(trim(sm.unit), '')) as unit,
        count(*) as sample_count,
        count(sm.metric_value_num) as numeric_count,
        coalesce(sum(sm.metric_value_num), 0)::numeric(20, 3) as numeric_sum,
        coalesce(
