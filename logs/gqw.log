      and trim(coalesce(nullif(a.attr_value, ''), nullif(a.attr_value_json, ''))) <> ''
    group by 1, 2, 3, 4, 5
    on conflict (day_start, module_code, event_type_code, attribute_type_code, attribute_value)
    do update set sample_count = excluded.sample_count
]
