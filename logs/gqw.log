        p95_ms,
        p99_ms,
        max_ms
    )
    select
        date_bin(
            (? || ' minutes')::interval,
            e.started_at,
            ?
        ) as bucket_start,
        ? as granularity_minutes,
        coalesce(e.module_code, ?) as module_code,
        e.event_type_code,
        count(*) as sample_count,
        sum(case when e.is_error then 1 else 0 end) as error_count,
